{
  "name": "betmatesss",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:rls": "node __tests__/rls/run.js",
    "size": "node scripts/check-app-size.js",
    "lint": "expo lint __tests__",
    "check:knip": "knip",
    "check:jscpd": "jscpd src __tests__"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/",
      "/__tests__/rls/",
      "/betmates-portfolio/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/betmates-portfolio/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.14.10",
    "@sentry/react-native": "^8.22.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.101.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zod": "^4.4.3"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "danger": "^13.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "expo-doctor": "1.20.2",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.16",
    "jest-fail-on-console": "^3.3.4",
    "jscpd": "^5.0.15",
    "knip": "^6.32.2",
    "react-test-renderer": "^19.1.0",
    "supabase": "2.115.0",
    "typescript": "~5.9.2"
  }
}
