{
  "name": "betmatesss",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:mutation": "stryker run",
    "test:rls": "node __tests__/rls/run.js",
    "size": "node scripts/check-app-size.js",
    "lint": "expo lint __tests__",
    "check:knip": "knip",
    "check:jscpd": "jscpd src __tests__"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/",
      "/__tests__/rls/",
      "/betmates-portfolio/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/betmates-portfolio/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.14.10",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.101.4",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-modules-core": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "zod": "^4.4.3"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "25.6.0",
    "@types/react": "~19.2.4",
    "danger": "^13.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "expo-doctor": "1.20.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "jest-fail-on-console": "^3.3.4",
    "jscpd": "^5.0.15",
    "knip": "^6.32.2",
    "react-test-renderer": "^19.1.0",
    "supabase": "2.115.0",
    "typescript": "~6.0.3"
  }
}
